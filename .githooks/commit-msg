#!/usr/bin/env bash
# Rejects commit messages containing Chinese or Japanese text. Enable with:
#   git config core.hooksPath .githooks
set -euo pipefail
if grep -v '^#' "$1" | perl -CSD -ne '$found ||= /\p{Han}|\p{Hiragana}|\p{Katakana}/; END { exit($found ? 0 : 1) }'; then
  printf 'error: commit messages in this repository are written in English\n' >&2
  exit 1
fi
