From 2fa940feeaf2f0a66f074caef4ffd9a88fd0e7c9 Mon Sep 17 00:00:00 2001
From: Feifan He <feifan@codeweavers.com>
Date: Mon, 27 Apr 2026 19:02:44 +0800
Subject: [PATCH 07/26] fix(d3d11, dxmt): sanitize invalid draw calls

Signed-off-by: Feifan He <feifan@codeweavers.com>

(cherry picked from commit 46911d734538d26cdd036a71fd80a9a01fd7c126)
---
 src/d3d11/d3d11_context_impl.cpp | 40 +++++++++++++++++++++++---------
 src/dxmt/dxmt_command.metal      | 10 ++++----
 2 files changed, 35 insertions(+), 15 deletions(-)

diff --git a/src/d3d11/d3d11_context_impl.cpp b/src/d3d11/d3d11_context_impl.cpp
index e1e683d..0c52708 100644
--- a/src/d3d11/d3d11_context_impl.cpp
+++ b/src/d3d11/d3d11_context_impl.cpp
@@ -1,11 +1,25 @@
+/*
+ * This file is included by d3d11_context_{imm|def}.cpp
+ * and should be not used as a compilation unit
+ * since it is for internal use only (and I don't want to deal with several thousands line of code)
