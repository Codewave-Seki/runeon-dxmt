diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 2776e47..06a6382 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -9,6 +9,11 @@
 #include "objc/objc-runtime.h"
 #include <bootstrap.h>
 #include <mach/mach_port.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
 #define WINEMETAL_API
 #include "../winemetal_thunks.h"
 #include "../airconv_thunks.h"
@@ -3181,6 +3186,28 @@ NTSTATUS _CacheWriter_alloc_init(void *obj);
 NTSTATUS _CacheWriter_set(void *obj);
 NTSTATUS _WMTSetMetalShaderCachePath(void *obj);
 
+static NTSTATUS
+_WMTPlacedMemoryRemoveExecute(void *obj) {
+  struct unixcall_generic_obj_uint64_noret *params = obj;
+  static atomic_int reported;
+  void *ptr = (void *)params->handle;
+  int err;
+
+  // Never round out to host pages: that could touch memory owned by someone else.
+  if ((params->handle | params->arg) & (getpagesize() - 1))
+    err = EINVAL;
+  // Wine adds PROT_EXEC again only when it changes this range itself: VirtualProtect
+  // on it, or the process turning DEP from on to off.
+  else if (!mprotect(ptr, params->arg, PROT_READ | PROT_WRITE))
+    return STATUS_SUCCESS;
+  else
+    err = errno;
+  if (atomic_fetch_add(&reported, 1) < 8)
+    fprintf(stderr, "err:winemetal:WMTPlacedMemoryRemoveExecute: %p+%#llx stays executable: %s\n", ptr,
+            (unsigned long long)params->arg, strerror(err));
+  return STATUS_UNSUCCESSFUL;
+}
+
 const void *__wine_unix_call_funcs[] = {
     &_NSObject_retain,
     &_NSObject_release,
@@ -3328,6 +3355,7 @@ const void *__wine_unix_call_funcs[] = {
     &_MTLDevice_newIndirectCommandBuffer,
     &_MTLDevice_newLibraryWithSource,
     &_MTLTexture_getBytes,
+    &_WMTPlacedMemoryRemoveExecute,
 };
 
 #ifndef DXMT_NATIVE
@@ -3478,5 +3506,6 @@ const void *__wine_unix_call_wow64_funcs[] = {
     &_MTLDevice_newIndirectCommandBuffer,
     &_MTLDevice_newLibraryWithSource,
     &_MTLTexture_getBytes,
+    &_WMTPlacedMemoryRemoveExecute,
 };
 #endif
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index 97fffc7..b299e6f 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2143,6 +2143,12 @@ WINEMETAL_API obj_handle_t MTLDevice_newIndirectCommandBuffer(
 WINEMETAL_API obj_handle_t
 MTLDevice_newLibraryWithSource(obj_handle_t device, const char *source, uint64_t length, obj_handle_t *err_out);
 
+/* Page-aligned memory for newBuffer() to place a buffer in; NULL on failure, which
+ * callers must not pass on, since newBuffer() reads NULL as "let Metal allocate". */
+WINEMETAL_API void *WMTPlacedMemoryAllocate(uint64_t length);
+
+WINEMETAL_API void WMTPlacedMemoryFree(void *ptr);
+
 WINEMETAL_API void MTLTexture_getBytes(
     obj_handle_t texture, struct WMTOrigin origin, struct WMTSize size, uint64_t level, uint64_t slice,
     struct WMTMemoryPointer data, uint64_t bytes_per_row, uint64_t bytes_per_image
diff --git a/src/winemetal/winemetal_thunks.c b/src/winemetal/winemetal_thunks.c
index 42286c9..b1b552f 100644
--- a/src/winemetal/winemetal_thunks.c
+++ b/src/winemetal/winemetal_thunks.c
@@ -6,8 +6,10 @@
 
 #include "winemetal_thunks.h"
 #include <wineunixlib.h>
+#include "winbase.h"
 #include "assert.h"
 #include "string.h"
+#include <malloc.h>
 
 #ifdef NDEBUG
 #define UNIX_CALL(code, params) WINE_UNIX_CALL(code, params)
@@ -1331,3 +1333,52 @@ MTLTexture_getBytes(
   params.bytes_per_image = bytes_per_image;
   UNIX_CALL(145, &params);
 }
+
+/* When the executable, or a DLL it loads, lacks NX_COMPAT, Wine runs a 32-bit
+ * process with DEP off and maps every readable page executable on the host. Metal
+ * is very slow with buffers placed in such memory (upstream issue #161), so placed
+ * memory gets a view of its own that the unix side keeps read/write only. */
+static bool
+placed_memory_nonexec(void) {
+  static LONG state = -1;
+  DWORD flags;
+  BOOL permanent;
+
+  // ponytail: decided once per process so that allocate and free pair up. It is not
+  // revisited: if DEP later goes from on to off, Wine makes all memory executable
+  // again, and memory allocated while DEP was on was never given its own view.
+  if (state < 0)
+    InterlockedCompareExchange(
+        &state, GetProcessDEPPolicy(GetCurrentProcess(), &flags, &permanent) && !(flags & PROCESS_DEP_ENABLE), -1
+    );
+  return state;
+}
+
+WINEMETAL_API void *
+WMTPlacedMemoryAllocate(uint64_t length) {
+  struct unixcall_generic_obj_uint64_noret params;
+  void *ptr;
+
+  if (!placed_memory_nonexec())
+    return _aligned_malloc(length, 4096);
+  // A view of its own is page-aligned, one VM region, and shares no page with other data.
+  // ponytail: one 64 KiB-granular view per allocation, no sub-allocator; this spends
+  // 32-bit address space on small buffers, in DEP-off processes only.
+  length = (length + 4095) & ~(uint64_t)4095;
+  if (!(ptr = VirtualAlloc(NULL, length, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)))
+    return NULL;
+  params.handle = PtrToUInt64(ptr);
+  params.arg = length;
+  // A failure is logged by the unix side, which knows why; the memory then stays
+  // executable, as before, and is still usable.
+  WINE_UNIX_CALL(146, &params);
+  return ptr;
+}
+
+WINEMETAL_API void
+WMTPlacedMemoryFree(void *ptr) {
+  if (!placed_memory_nonexec())
+    _aligned_free(ptr);
+  else if (ptr)
+    VirtualFree(ptr, 0, MEM_RELEASE);
+}
