From 7a8a894f0a11c301f757ee8d10d2a7a5e6ac0113 Mon Sep 17 00:00:00 2001
From: Runeon Contributors <support@runeon.app>
Date: Tue, 17 Nov 2026 02:38:33 +0900
Subject: [PATCH] winemetal: keep placed buffer memory non-executable (Runeon)

When an executable, or a DLL it loads, lacks NX_COMPAT, Wine runs a
32-bit process with DEP off and adds PROT_EXEC to every readable host
mapping. DXMT places Metal buffers in such memory with
newBufferWithBytesNoCopy, and on recent macOS Metal is very slow with
it (upstream issue #161).

Add WMTPlacedMemoryAllocate and WMTPlacedMemoryFree and use them for
every CPU-placed allocation: placed buffers, linear textures, the dummy
constant buffer, visibility result buffers and placed staging blocks.
In a process with DEP off each allocation is a VirtualAlloc view of its
own, so it stays inside the address range Wine manages, is page-aligned,
forms a single VM region and shares no page with other data; a new unix
call then drops PROT_EXEC from exactly that range. Wine adds it back
only when VirtualProtect changes that range or when the process turns
DEP from on to off; DXMT does neither. The process DEP policy is left
alone. If the unix call fails, the memory stays executable as before
and the first failures are logged with address, length and reason.

The choice is made once per process from GetProcessDEPPolicy. That
keeps allocations and frees paired, but it is not revisited: if the
process later turns DEP from on to off, its placed memory becomes
executable like all other memory. With DEP on, which includes every
64-bit process, the helpers fall back to _aligned_malloc with page
alignment, as before. Placed staging blocks used plain malloc and now
get page alignment in every process. Each view costs 64 KiB of address
space, which small buffers in DEP-off 32-bit processes now pay.

None of the five callers has a way to report a failed allocation, and
going on with NULL lets Metal allocate memory a 32-bit process may not
reach, or adds offsets to NULL. A failed allocation now logs an error
and aborts.
---
 src/dxmt/dxmt_buffer.cpp              | 10 ++++--
 src/dxmt/dxmt_context.cpp             |  9 +++--
 src/dxmt/dxmt_occlusion_query.hpp     | 10 ++++--
 src/dxmt/dxmt_ring_bump_allocator.hpp |  9 +++--
 src/dxmt/dxmt_texture.cpp             | 10 ++++--
 src/winemetal/unix/winemetal_unix.c   | 29 +++++++++++++++
 src/winemetal/winemetal.h             |  6 ++++
 src/winemetal/winemetal_thunks.c      | 51 +++++++++++++++++++++++++++
 8 files changed, 124 insertions(+), 10 deletions(-)

diff --git a/src/dxmt/dxmt_buffer.cpp b/src/dxmt/dxmt_buffer.cpp
index 9a4139d..3ad041b 100644
--- a/src/dxmt/dxmt_buffer.cpp
+++ b/src/dxmt/dxmt_buffer.cpp
@@ -18,6 +18,7 @@
 
 #include "dxmt_buffer.hpp"
 #include "dxmt_format.hpp"
+#include "log/log.hpp"
 #include "thread.hpp"
 #include "util_likely.hpp"
 #include "util_math.hpp"
@@ -42,7 +43,12 @@ BufferAllocation::BufferAllocation(WMT::Device device, const WMTBufferInfo &info
   }
   fenceTrackers.resize(suballocation_count_);
   if (flags_.test(BufferAllocationFlag::CpuPlaced)) {
-    placed_buffer = wsi::aligned_malloc(info_.length, DXMT_PAGE_SIZE);
+    placed_buffer = WMTPlacedMemoryAllocate(info_.length);
+    // No caller of Buffer::allocate() can handle a failed allocation.
+    if (!placed_buffer) {
+      ERR("BufferAllocation: failed to allocate ", info_.length, " bytes of placed memory");
+      abort();
+    }
     info_.memory.set(placed_buffer);
   }
   obj_ = device.newBuffer(info_);
@@ -73,7 +79,7 @@ BufferAllocation::BufferAllocation(
 void
 BufferAllocation::free() {
   if (placed_buffer) {
-    wsi::aligned_free(placed_buffer);
+    WMTPlacedMemoryFree(placed_buffer);
     placed_buffer = nullptr;
   }
   delete this;
diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index 7b29f1e..79330ba 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -55,7 +55,12 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
   dummy_sampler_info_.max_anisotroy = 1;
   dummy_sampler_info_.lod_average = false;
   dummy_sampler_ = device.newSamplerState(dummy_sampler_info_);
-  dummy_cbuffer_host_ = wsi::aligned_malloc(65536, DXMT_PAGE_SIZE);
+  dummy_cbuffer_host_ = WMTPlacedMemoryAllocate(65536);
+  // A constructor without a failure path.
+  if (!dummy_cbuffer_host_) {
+    ERR("ArgumentEncodingContext: failed to allocate the dummy constant buffer");
+    abort();
+  }
   dummy_cbuffer_info_.length = 65536;
   dummy_cbuffer_info_.memory.set(dummy_cbuffer_host_);
   dummy_cbuffer_info_.options = WMTResourceOptionCPUCacheModeWriteCombined | WMTResourceStorageModeShared |
@@ -70,7 +75,7 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
 };
 
 ArgumentEncodingContext::~ArgumentEncodingContext() {
-  wsi::aligned_free(dummy_cbuffer_host_);
+  WMTPlacedMemoryFree(dummy_cbuffer_host_);
 };
 
 template void ArgumentEncodingContext::encodeVertexBuffers<PipelineKind::Ordinary>(uint32_t slot_mask, uint64_t argument_buffer_offset);
